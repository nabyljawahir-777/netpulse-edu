{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "1. Run NetPulse (Node.js & Express Backend)",
      "runtimeProgram": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "java",
      "name": "2. Run NetPulse (Java Backend Application)",
      "request": "launch",
      "mainClass": "com.netpulse.NetPulseJavaApplication",
      "projectName": "netpulse-edu"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "3. Open NetPulse in Chrome (http://localhost:3000)",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
